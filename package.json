{
  "name": "synthetix-v3",
  "version": "0.0.0",
  "private": true,
  "description": "Mono Repo with Contracts and JS tooling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synthetixio/synthetix-v3.git"
  },
  "bugs": {
    "url": "https://github.com/Synthetixio/synthetix-v3/issues"
  },
  "author": "Synthetix",
  "license": "MIT",
  "homepage": "https://github.com/Synthetixio/synthetix-v3#readme",
  "scripts": {
    "clean": "moon run :clean",
    "generate-testable": "moon run :generate-testable",
    "build-testable": "moon run :build-testable",
    "compile-contracts": "moon run :compile-contracts",
    "build:ts": "moon run :build-ts",
    "build": "moon run :build",
    "size-contracts": "moon run :size-contracts",
    "storage:dump": "moon run :storage-dump",
    "storage:verify": "moon run :storage-verify",
    "build:contracts": "moon run :build-contracts",
    "check:storage": "moon run :check-storage",
    "test": "moon run :test",
    "coverage": "moon run :coverage",
    "lint:progress": "ESLINT_PROGRESS=true eslint --max-warnings=0 .",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:js:fix": "eslint --max-warnings=0 --fix .",
    "lint:sol": "solhint **/*.sol",
    "lint:sol:fix": "solhint --fix **/*.sol",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" \"!**/lib/**\" \"!.superpowers/**\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"**/*.mdx\" \"!**/lib/**\" \"!.superpowers/**\"",
    "lint:yaml": "uv tool run yamllint -c .yamllint .",
    "pretty:fix": "prettier --write --ignore-unknown '**/*'",
    "pretty": "prettier --check --ignore-unknown '**/*'",
    "lint:fix": "pnpm pretty:fix && pnpm lint:js:fix && pnpm lint:sol:fix",
    "lint": "pnpm pretty && pnpm lint:js && pnpm lint:sol",
    "deps": "deps",
    "deps:fix": "deps --fix",
    "deps:mismatched": "deps-mismatched",
    "deps:circular": "deps-circular",
    "publish-contracts": "moon run :publish-contracts",
    "docgen:contracts": "moon run :clean && moon run :docgen && pnpm --filter @synthetixio/docgen run docgen:contracts",
    "subgraph:codegen": "moon run :subgraph-codegen",
    "subgraph:build": "moon run :subgraph-build",
    "check-staged": "lint-staged",
    "copy-storage": "bash -c 'for f in $(find . -name 'storage.new.dump.json'); do cp $f $(dirname $f)/storage.dump.json; git add $(dirname $f)/storage.dump.json; done'",
    "changed": "moon query projects --affected",
    "audit": "pnpm audit --audit-level high",
    "cannon:update": "bun scripts/cannon-update.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "@ethersproject/abi": "catalog:eth",
    "@ethersproject/providers": "catalog:eth",
    "@liqcx/tooling-sync": "catalog:lint",
    "@nomiclabs/hardhat-ethers": "catalog:hardhat",
    "@synthetixio/deps": "workspace:*",
    "@types/debug": "catalog:utils",
    "@types/fs-extra": "catalog:utils",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/semver": "catalog:utils",
    "@typescript-eslint/eslint-plugin": "catalog:lint",
    "@typescript-eslint/parser": "catalog:lint",
    "@usecannon/builder": "catalog:cannon",
    "@usecannon/cli": "catalog:cannon",
    "eslint": "catalog:lint",
    "eslint-plugin-progress": "workspace:*",
    "eslint-plugin-no-only-tests": "catalog:lint",
    "forge-std": "catalog:testing",
    "globals": "catalog:lint",
    "lint-staged": "catalog:lint",
    "markdownlint-cli2": "catalog:lint",
    "pre-commit": "catalog:lint",
    "prettier": "catalog:lint",
    "prettier-plugin-solidity": "catalog:lint",
    "prettier-plugin-toml": "catalog:lint",
    "solhint": "catalog:lint",
    "solhint-plugin-meta-transactions": "catalog:lint",
    "solhint-plugin-numcast": "catalog:lint",
    "ts-node": "catalog:build",
    "typescript": "catalog:build"
  },
  "pre-commit": [
    "check-staged",
    "copy-storage"
  ],
  "lint-staged": {
    "*.js": [
      "pnpm exec prettier --check",
      "pnpm exec eslint --max-warnings=0"
    ],
    "*.ts": [
      "pnpm exec prettier --check",
      "pnpm exec eslint --max-warnings=0"
    ],
    "*.sol": [
      "pnpm exec prettier --check",
      "pnpm exec solhint"
    ],
    "*.toml": "pnpm exec prettier --check",
    "*.yml": "pnpm exec prettier --check",
    "*.yaml": "pnpm exec prettier --check",
    "*.json": "pnpm exec prettier --check",
    "*.md": "pnpm exec prettier --check"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.2"
}
