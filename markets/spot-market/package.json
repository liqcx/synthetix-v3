{
  "name": "@synthetixio/spot-market",
  "version": "3.13.1",
  "description": "Spot Market implementation",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "!contracts/generated",
    "hardhat.config.ts",
    "storage.dump.json",
    "*.toml"
  ],
  "scripts": {
    "clean": "bun x hardhat clean && rm -rf contracts/generated",
    "build": "yarn build:contracts",
    "build:contracts": "bun x hardhat compile --force && yarn storage:dump && CANNON_REGISTRY_PRIORITY=local bun x hardhat cannon:build",
    "storage:dump": "bun x hardhat storage:dump --output storage.new.dump.json",
    "storage:verify": " bun x hardhat storage:verify",
    "build-testable": "CANNON_REGISTRY_PRIORITY=local bun x hardhat cannon:build cannonfile.test.toml",
    "check:storage": "diff -uw storage.dump.json storage.new.dump.json",
    "start": "yarn build && yarn cannon-build",
    "cannon-build": "bun x hardhat cannon:build",
    "test": "CANNON_REGISTRY_PRIORITY=local bun x hardhat test",
    "test:fork": "bun x hardhat test test-fork/AsyncOrdersModule.e2e.test.ts",
    "coverage": "bun x hardhat test",
    "coverage1": "bun x hardhat coverage --network hardhat",
    "compile-contracts": "bun x hardhat compile",
    "publish-contracts": "cannon publish synthetix-spot-market:$(node -p 'require(`./package.json`).version') --chain-id 13370 --quiet --tags $(node -p '/^\\d+\\.\\d+\\.\\d+$/.test(require(`./package.json`).version) ? `latest` : `dev`')",
    "deploy": "yarn build && yarn publish-contracts",
    "size-contracts": "bun x hardhat compile && bun x hardhat size-contracts",
    "docgen": "bun x hardhat docgen"
  },
  "keywords": [],
  "author": "Synthetix",
  "license": "MIT",
  "devDependencies": {
    "@synthetixio/common-config": "workspace:*",
    "@synthetixio/core-contracts": "workspace:*",
    "@synthetixio/core-modules": "workspace:*",
    "@synthetixio/core-utils": "workspace:*",
    "@synthetixio/docgen": "workspace:*",
    "@synthetixio/main": "workspace:*",
    "@synthetixio/oracle-manager": "workspace:*",
    "@synthetixio/wei": "^2.74.4",
    "@types/node-fetch": "^2.6.11",
    "@usecannon/cli": "npm:@alxwlw/cannon-cli@2.26.1-nonce.1",
    "ethers": "^5.7.2",
    "hardhat": "^2.28.0",
    "node-fetch": "^2.7.0",
    "solidity-docgen": "^0.6.0-beta.36",
    "typescript": "^5.5.4"
  }
}
