{
  "name": "@synthetixio/treasury-market",
  "version": "3.13.1",
  "description": "V3 Market to allow a trusted entity to manage excess liquidity on behalf of stakers",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "!contracts/generated",
    "hardhat.config.ts",
    "storage.dump.json",
    "*.toml"
  ],
  "scripts": {
    "forge-coverage": "forge coverage -vvvv --report lcov"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@synthetixio/common-config": "workspace:*",
    "@synthetixio/core-contracts": "workspace:*",
    "@synthetixio/core-modules": "workspace:*",
    "@synthetixio/docgen": "workspace:*",
    "@synthetixio/main": "workspace:*",
    "@synthetixio/oracle-manager": "workspace:*",
    "@usecannon/cli": "catalog:cannon",
    "forge-std": "catalog:testing",
    "hardhat": "catalog:hardhat",
    "solidity-docgen": "catalog:solidity"
  },
  "depcheck": {
    "ignoreMatches": [
      "@synthetixio/main",
      "@synthetixio/oracle-manager",
      "forge-std"
    ]
  }
}
