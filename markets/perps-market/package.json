{
  "name": "@synthetixio/perps-market",
  "version": "3.11.5-orderbook",
  "description": "Perps Market implementation",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "!contracts/generated",
    "hardhat.config.ts",
    "storage.dump.json",
    "*.toml"
  ],
  "scripts": {
    "build-testable:foundry": "bun scripts/foundry-cannonfile.ts && CANNON_REGISTRY_PRIORITY=local bun x hardhat cannon:build cannonfile.test.foundry.toml --write-script script/Deploy.sol --write-script-format foundry --wipe",
    "start": "moon run perps-market:build && pnpm run cannon-build",
    "cannon-build": "bun x hardhat cannon:build",
    "test:isolated": "bash scripts/test-isolated.sh",
    "coverage1": "bun x hardhat coverage --network hardhat"
  },
  "keywords": [],
  "author": "Synthetix",
  "license": "MIT",
  "devDependencies": {
    "@synthetixio/common-config": "workspace:*",
    "@synthetixio/core-contracts": "workspace:*",
    "@synthetixio/core-modules": "workspace:*",
    "@synthetixio/core-utils": "workspace:*",
    "@synthetixio/docgen": "workspace:*",
    "@synthetixio/main": "workspace:*",
    "@synthetixio/oracle-manager": "workspace:*",
    "@synthetixio/rewards-dist-ext": "workspace:*",
    "@synthetixio/rewards-distributor": "workspace:*",
    "@synthetixio/spot-market": "workspace:*",
    "@synthetixio/wei": "^2.74.4",
    "@usecannon/cli": "npm:@alxwlw/cannon-cli@2.26.1-nonce.1",
    "ethers": "^5.7.2",
    "hardhat": "^2.28.0",
    "solidity-docgen": "^0.6.0-beta.36",
    "typescript": "^5.5.4"
  },
  "depcheck": {
    "ignoreMatches": [
      "@synthetixio/core-contracts",
      "@synthetixio/core-modules",
      "@synthetixio/rewards-dist-ext",
      "@synthetixio/rewards-distributor"
    ]
  }
}
