# Toolchain pins (proto-managed) — @liqcx standard adoption (P3b).
# node 24.14.0 is FORCED: pnpm 11.1.2 requires Node >= 22.13 (node:sqlite
# builtin), so the repo's old 20.17 pin is incompatible with the canon pm.
# bun runs `bun x hardhat` inside package scripts.
proto = "0.56.4"
node = "24.14.0"
pnpm = "11.1.2"
bun = "1.3.14"
# moon orchestrates the workspace's tasks. setup-liqcx (moonrepo/setup-toolchain,
# auto-install: true) installs whatever this file lists, so CI needs no extra step.
moon = "2.2.5"

# AI-first guardrails — pinned and wired into the canon GHA lint gate (P3d).
actionlint = "1.7.12"
shellcheck = "0.11.0"
gitleaks = "8.30.1"
# uv runs `pnpm lint:yaml` (yamllint via `uv tool run`) in the lint job.
uv = "0.11.6"

[plugins]
actionlint = "https://raw.githubusercontent.com/Phault/proto-toml-plugins/main/actionlint/plugin.toml"
shellcheck = "https://raw.githubusercontent.com/Phault/proto-toml-plugins/main/shellcheck/plugin.toml"
gitleaks = "https://raw.githubusercontent.com/Phault/proto-toml-plugins/main/gitleaks/plugin.toml"
