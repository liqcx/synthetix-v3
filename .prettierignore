# Canon-managed, verbatim strategy — liqcx-tooling-sync owns these byte for
# byte and its --check compares against its own templates. Formatting them to
# this repo's .prettierrc (4-space TOML, no-tabs JSON) puts the two gates in
# permanent conflict, so Prettier does not touch them. (.gitleaks.toml and
# .syncpackrc.cjs are NOT here: the canon seeds those create-if-absent and they
# are the repo's afterwards.)
.editorconfig
.markdownlint-cli2.jsonc
.gitleaks.canon.toml
.yamllint
.yamllint-canon-ignores
.dependency-cruiser.base.cjs
