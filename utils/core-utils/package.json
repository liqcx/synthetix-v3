{
  "name": "@synthetixio/core-utils",
  "version": "3.13.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Common JS utils for Synthetix",
  "files": [
    "src",
    "utils/**/*.js",
    "utils/**/*.js.map",
    "utils/**/*.d.ts",
    "utils/**/*.d.ts.map"
  ],
  "scripts": {
    "watch": "bun x tsc --noEmit false --project src/tsconfig.json --watch",
    "test:watch": "bun x mocha --require ts-node/register --watch",
    "prepublishOnly": "bun x tsc --noEmit false --project src/tsconfig.json"
  },
  "peerDependencies": {
    "@usecannon/builder": ">=2.16.2-0",
    "@usecannon/cli": ">=2.16.2-0",
    "ethers": "^5.7.2",
    "solidity-ast": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@usecannon/builder": {
      "optional": true
    },
    "@usecannon/cli": {
      "optional": true
    },
    "ethers": {
      "optional": true
    },
    "solidity-ast": {
      "optional": true
    }
  },
  "devDependencies": {
    "@foundry-rs/hardhat-anvil": "^0.1.7",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/micromatch": "^4",
    "@types/prompts": "^2.4.9",
    "@usecannon/builder": "npm:@alxwlw/cannon-builder@2.26.1-nonce.1",
    "@usecannon/cli": "npm:@alxwlw/cannon-cli@2.26.1-nonce.1",
    "bun-types": "^1.4.2",
    "ethers": "^5.7.2",
    "get-port": "^7.0.0",
    "hardhat": "^2.28.0",
    "mocha": "^10.7.3",
    "nyc": "^17.0.0",
    "sinon": "^18.0.0",
    "solc": "0.8.34",
    "solidity-ast": "^0.4.55",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.7.0",
    "chalk": "^4.1.2",
    "ethereumjs-util": "^7.1.5",
    "fast-glob": "^3.3.2",
    "micromatch": "4.0.8",
    "prompts": "^2.4.2",
    "rfdc": "^1.3.1",
    "viem": "^2.29.4"
  },
  "depcheck": {
    "ignoreMatches": [
      "bun-types",
      "bun:test"
    ]
  }
}
