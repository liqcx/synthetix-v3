{
  "name": "@synthetixio/hardhat-storage",
  "version": "3.13.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Solidity Contracts Storage Validation",
  "main": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "keywords": [
    "hardhat",
    "storage",
    "solidity"
  ],
  "files": [
    "src",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "author": "Synthetix",
  "license": "MIT",
  "scripts": {
    "watch": "bun x tsc --noEmit false --project src/tsconfig.json --watch",
    "test:watch": "jest --watch",
    "prepublishOnly": "bun x tsc --noEmit false --project src/tsconfig.json"
  },
  "dependencies": {
    "@solidity-parser/parser": "catalog:solidity",
    "@synthetixio/core-utils": "workspace:*",
    "chalk": "catalog:utils",
    "cli-table3": "catalog:utils",
    "lodash.memoize": "catalog:utils",
    "mustache": "catalog:utils",
    "solidity-ast": "catalog:solidity"
  },
  "devDependencies": {
    "@types/jest": "catalog:testing",
    "@types/lodash.memoize": "catalog:utils",
    "@types/mustache": "catalog:utils",
    "hardhat": "catalog:hardhat",
    "jest": "catalog:testing",
    "micromatch": "catalog:utils",
    "ts-jest": "catalog:testing",
    "typescript": "catalog:build"
  }
}
