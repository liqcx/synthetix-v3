{
  "name": "@synthetixio/core-contracts",
  "version": "3.13.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "contracts",
    "!contracts/generated",
    "hardhat.config.ts",
    "storage.dump.json",
    "*.toml"
  ],
  "description": "Base solidity contracts",
  "author": "Synthetix",
  "license": "MIT",
  "keywords": [
    "hardhat",
    "solidity",
    "proxy",
    "ownership"
  ],
  "scripts": {},
  "devDependencies": {
    "@ethersproject/abstract-provider": "catalog:eth",
    "@ethersproject/bignumber": "catalog:eth",
    "@synthetixio/common-config": "workspace:*",
    "@synthetixio/core-utils": "workspace:*",
    "@synthetixio/docgen": "workspace:*",
    "ethers": "catalog:eth",
    "hardhat": "catalog:hardhat",
    "solidity-docgen": "catalog:solidity"
  },
  "depcheck": {
    "ignoreMatches": [
      "@ethersproject/abi",
      "@ethersproject/providers",
      "@nomiclabs/hardhat-ethers"
    ]
  }
}
