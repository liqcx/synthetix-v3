{
  "$schema": "./node_modules/@alxwlw/stack/schema.json",
  "profile": "contracts",
  "with": [],
  "exceptions": [
    {
      "file": ".prototools",
      "reason": "The whole toolchain file is held, and with it package.json#packageManager: node 24.14.0, pnpm 11.1.2, bun 1.3.14 and the proto/moon/uv pins. Canon pnpm 11.15 re-resolves the lockfile and node 26 is unverified under Hardhat/Cannon/EDR; a toolchain upgrade is its own change (then drop this exception)",
    },
    {
      "file": ".oxfmtrc.jsonc",
      "reason": "Formatting stays on Prettier: prettier-plugin-solidity formats the .sol sources, oxfmt cannot",
    },
    {
      "file": ".oxlintrc.json",
      "reason": "Linting stays on ESLint 9 + solhint; the oxlint move (owner ruling (a), 2026-10-06) covers dev-agent, kwenta and monorepo only",
    },
    {
      "file": "tsconfig.options.json",
      "reason": "TypeScript stays on 5.5 from catalog:build (Hardhat + typechain toolchain); the canon options target TS 7",
    },
    {
      "file": ".github/workflows/stack-check.yml",
      "reason": "stack check runs as a step of the ci.yml lint job, where the workspace is already installed",
    },
  ],
}
